
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dropshipping Store</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="main">

    <div class="navbar">

        <div class="logo">
            <h2>Dropshipping</h2>
        </div>

        <div class="menu">
            <ul>
                <li><a href="#">HOME</a></li>
                <li><a href="#">ABOUT</a></li>
                <li><a href="#">PRODUCTS</a></li>
                <li><a href="#">SERVICES</a></li>
                <li><a href="#">CONTACT</a></li>
            </ul>
        </div>

        <div class="search">
            <input class="srch" type="search" placeholder="Type To Search">
            <button class="btn">Search</button>
        </div>

    </div>

    <div class="content">
        <h1>Trending Products<br><span>For Your</span><br>Business</h1>

        <p class="par">
            Discover winning products, fast shipping,
            and trusted suppliers to grow your online store.
        </p>

        <button class="cn"><a href="#">SHOP NOW</a></button>
    </div>

    <div class="form">
        <h2>Login Here</h2>

        <input type="email" placeholder="Enter Email Here">
        <input type="password" placeholder="Enter Password Here">

        <button class="btnn"><a href="#">Login</a></button>

        <p class="link">
            Don't have an account?<br>
            <a href="#">Sign Up Here</a>
        </p>
    </div>

</div>*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#0a192f;
}

.main{
    width:100%;
    height:100vh;

    background:
    linear-gradient(
        rgba(0,0,0,0.65),
        rgba(0,0,0,0.65)
    ),
    url("file.jpg");

    background-position:center;
    background-size:cover;
    background-repeat:no-repeat;
}

.navbar{
    width:1200px;
    height:75px;
    margin:auto;
}

.logo{
    color:#64b5f6;
    font-size:35px;
    font-family:Arial,sans-serif;
    float:left;
    padding-top:10px;
}

.menu{
    width:400px;
    float:left;
    height:70px;
}

ul{
    float:left;
    display:flex;
    justify-content:center;
    align-items:center;
}

ul li{
    list-style:none;
    margin-left:60px;
    margin-top:27px;
}

ul li a{
    text-decoration:none;
    color:#fff;
    font-family:Arial,sans-serif;
    font-weight:bold;
    transition:.3s;
}

ul li a:hover{
    color:#64b5f6;
}

.search{
    width:330px;
    float:left;
    margin-left:270px;
}

.srch{
    width:200px;
    height:40px;
    background:transparent;
    border:1px solid #64b5f6;
    color:#fff;
    margin-top:13px;
    padding:10px;
}

.btn{
    width:100px;
    height:40px;
    background:#1565c0;
    border:none;
    color:white;
}

.content{
    width:1200px;
    margin:auto;
    color:white;
    padding-top:100px;
}

.content h1{
    font-size:70px;
    margin:0;
    text-shadow:2px 2px 10px rgba(0,0,0,.8);
}

.content span{
    color:#64b5f6;
}

.par{
    margin-top:20px;
    width:600px;
    line-height:30px;
    color:#e0e0e0;
}

.cn{
    width:170px;
    height:50px;
    background:#1565c0;
    border:none;
    border-radius:5px;
    margin-top:20px;
}

.cn a{
    text-decoration:none;
    color:white;
    font-weight:bold;
}

.form{
    width:300px;
    height:400px;
    background:rgba(0,0,0,.85);
    position:absolute;
    top:130px;
    right:120px;
    border-radius:10px;
    padding:25px;
}

.form h2{
    text-align:center;
    color:#1565c0;
    background:white;
    border-radius:10px;
    padding:8px;
}

.form input{
    width:100%;
    height:40px;
    background:transparent;
    border:none;
    border-bottom:1px solid #64b5f6;
    color:white;
    margin-top:30px;
    outline:none;
}

.btnn{
    width:100%;
    height:40px;
    border:none;
    background:#1565c0;
    margin-top:25px;
    border-radius:5px;
}

.btnn a{
    text-decoration:none;
    color:white;
    font-weight:bold;
}

.link{
    text-align:center;
    margin-top:20px;
    color:white;
}

.link a{
    color:#64b5f6;
}

</body>
</html>

